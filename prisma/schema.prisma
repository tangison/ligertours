// Liger Tours Namibia data. Enquiry leads from the contact and tour enquiry forms.
generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "sqlite"
  url      = env("DATABASE_URL")
}

model Lead {
  id         String   @id @default(cuid())
  name       String
  email      String
  phone      String?
  travelFrom String?
  groupSize  String?
  message    String
  source     String   @default("contact")
  createdAt  DateTime @default(now())
}
